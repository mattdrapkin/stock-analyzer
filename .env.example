# ── Required for news search and chat ───────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
# Used for both web search (news) and chat analysis
OPENAI_API_KEY=your_openai_key_here

# ── Optional tuning ──────────────────────────────────────────────────────────
# OpenAI model to use for web search (default: gpt-5.5)
# Recommended: gpt-5.5 for new integrations with Responses API + web_search tool
OPENAI_SEARCH_MODEL=gpt-5.5

# Search context size for web search (default: medium)
# Options: low, medium, high
# - low: Quick lookups with minimal context
# - medium: Balanced detail (recommended for most use cases)
# - high: More comprehensive search results
OPENAI_SEARCH_CONTEXT_SIZE=medium

# OpenAI model to use for chat (default: gpt-5.4-nano for cost efficiency)
OPENAI_MODEL=gpt-5.4-nano

# Maximum requests per minute to OpenAI API (default: 50)
# Helps prevent hitting rate limits by throttling outgoing requests
OPENAI_MAX_RPM=50

# Default minimum % movement to flag as "major" (default: 2.0)
MIN_MOVEMENT_PCT=2.0

# Cache TTL in seconds (default: 1800 = 30 min)
CACHE_TTL_SECONDS=1800

# Number of biggest movers to fetch news for in basket analysis (default: 10)
BASKET_NEWS_TOP_N=10
