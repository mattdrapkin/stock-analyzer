# ── News provider ───────────────────────────────────────────────────────────
# NewsAPI — https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# ── Required for the /chat endpoint ─────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# ── Optional tuning ──────────────────────────────────────────────────────────
# OpenAI model to use for chat (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL=gpt-4o-mini

# Default minimum % movement to flag as "major" (default: 2.0)
MIN_MOVEMENT_PCT=2.0

# Cache TTL in seconds (default: 1800 = 30 min)
CACHE_TTL_SECONDS=1800
